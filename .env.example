# LLM Configuration
# Provedor LLM (openrouter ou openai)
LLM_PROVIDER=openrouter
# Modelo a ser usado
LLM_MODEL=gpt-5-mini
# Base URL para o provedor (opcional - padrão já configurado)
LLM_BASE_URL=https://openrouter.ai/api/v1

# API Keys
# Chave da OpenRouter (obrigatória se LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Chave da OpenAI (obrigatória se LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/laura_db

# WhatsApp (Z-API)
WHATSAPP_API_KEY=your_zapi_api_key
WHATSAPP_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=your_instance_id

# JWT Security
JWT_SECRET=your_jwt_secret_min_32_chars
ENCRYPTION_KEY=your_encryption_key_min_32_chars

# Agent Configuration
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000

# Logging
LOG_LEVEL=info
WEBHOOK_DETAILED_LOGGING=true

# Webhook Behavior (segurança)
# ⚠️  DEIXE FALSE para produção - criações devem passar pelo Agent
USE_AUTOCREATE_FROM_TEXT=false

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=3600
# N8N Integration
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/sistema-laura
N8N_INTEGRATION_TOKEN=replace_with_local_token
