# Ambiente de Desenvolvimento Local
NODE_ENV=development

# Banco de Dados Local (SQLite - recomendado para desenvolvimento)
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Banco de Dados Local (PostgreSQL via Docker - opcional)
# DB_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/laura_db?schema=public"

# Redis Local (Docker)
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=3000
DASHBOARD_PORT=3001
WORKER_PORT=3002

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# WhatsApp Integration (Z-API)
ZAPI_INSTANCE_ID="your-zapi-instance-id"
ZAPI_TOKEN="your-zapi-token"
ZAPI_BASE_URL="https://api.z-api.io"

# Supabase (Produção - deixar vazio para desenvolvimento)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=laura_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (opcional para desenvolvimento)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Application Settings
APP_NAME="Sistema Laura"
APP_VERSION="1.0.0"
COMPANY_NAME="Kabatec"