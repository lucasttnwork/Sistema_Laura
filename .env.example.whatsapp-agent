# ===========================================
# CONFIGURAÇÃO DO AGENTE WHATSAPP
# ===========================================

# Z-API Configuration (OBRIGATÓRIO)
ZAPI_API_URL=https://api.z-api.io
ZAPI_API_TOKEN=seu_token_zapi_aqui
ZAPI_INSTANCE_ID=seu_instance_id_aqui
ZAPI_CLIENT_TOKEN=seu_client_token_opcional

# WhatsApp Agent Configuration
WHATSAPP_AGENT_WEBHOOK_SECRET=agent_webhook_secret_2025

# Database Configuration (OBRIGATÓRIO)
DATABASE_URL=postgresql://user:password@localhost:5432/laura_db

# API Base URL (para testes)
API_BASE_URL=http://localhost:3002

# Test Phone Number (para testes)
TEST_PHONE=+5511999999999

# ===========================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# ===========================================

# 1. COPIE este arquivo para .env
#    cp .env.example.whatsapp-agent .env

# 2. CONFIGURE as variáveis ZAPI_*
#    - Acesse https://app.z-api.io/
#    - Vá em "Instâncias" > "Gerenciar"
#    - Copie o TOKEN e INSTANCE_ID

# 3. CONFIGURE o DATABASE_URL
#    - Use a mesma URL do seu banco PostgreSQL

# 4. CONFIGURE o webhook no Z-API
#    - URL: https://seudominio.com/api/webhook/agent
#    - Eventos: message, status, disconnect
#    - Secret: agent_webhook_secret_2025

# ===========================================
# TESTE DA CONFIGURAÇÃO
# ===========================================

# Após configurar, execute:
# node scripts/test-whatsapp-agent.js

# Ou teste manualmente:
# curl http://localhost:3002/api/webhook/agent/health
