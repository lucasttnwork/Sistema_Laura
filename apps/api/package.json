{
  "name": "@bmad/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p .",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate --schema ../../packages/prisma/schema.prisma"
  },
  "dependencies": {
    "@bmad/observability": "workspace:*",
    "@prisma/client": "^6.15.0",
    "@types/express": "^5.0.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.6",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "eslint": "^8.54.0"
  }
}
