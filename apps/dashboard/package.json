{
  "name": "@bmad/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lighthouse": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "lighthouse": "lhci autorun --config=../../.lighthouserc.json",
    "lighthouse:desktop": "lhci autorun --config=../../.lighthouserc.desktop.json",
    "lighthouse:mobile": "lhci autorun --config=../../.lighthouserc.mobile.json",
    "lighthouse:all": "pnpm lighthouse:desktop && pnpm lighthouse:mobile"
  },
  "dependencies": {
    
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.543.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "eslint": "^8.54.0",
    "lighthouse": "^11.0.0",
    "playwright": "^1.40.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "@lhci/cli": "^0.14.0"
  }
}
