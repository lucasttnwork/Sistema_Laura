{
  "name": "@bmad/prisma",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prisma:generate": "prisma generate --schema ./schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --name init --schema ./schema.prisma",
    "prisma:studio": "prisma studio --schema ./schema.prisma",
    "seed": "tsx seeds/seed.ts",
    "seed:reset": "tsx seeds/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
