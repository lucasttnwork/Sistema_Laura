{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm preview:lighthouse",
      "startServerReadyPattern": "http://(127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/login",
        "http://localhost:4173/solicitacoes",
        "http://localhost:4173/obras",
        "http://localhost:4173/fornecedores",
        "http://localhost:4173/fiscais",
        "http://localhost:4173/cotacoes",
        "http://localhost:4173/contatos"
      ],
      "startServerReadyTimeout": 120000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:pwa": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lh-report/summary",
      "reportFilenamePattern": "summary-%%PATHNAME%%-%%DATE%%-%%HASH%%.%%EXTENSION%%"
    }
  }
}
